# Copy values into your shell or process manager; .env is not automatically loaded.
APP_MODE=demo
HOST=127.0.0.1
PORT=8000
BASE_URL=http://127.0.0.1:8000
DATA_DIR=.runtime
# Explicitly grant editors; no editor role exists by default.
EDITOR_EMAILS=editor@example.test
# Production requires HTTPS, a durable volume, SMTP, and the storage adapter described in README.
# APP_MODE=production
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional GitHub Pages + Supabase backend. These two values are PUBLIC.
# Set the same names as GitHub Actions repository variables to enable forms.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Follow docs/SUPABASE.md for database, Edge Function, editor, and email setup.
