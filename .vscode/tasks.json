{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Source Culture: start app",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "source-culture",
        "pattern": { "regexp": "^(.*):(\\d+): (.*)$", "file": 1, "line": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Source Culture",
          "endsPattern": "Local: http"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" }
    }
  ]
}
